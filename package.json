{
  "name": "agent-autoloop-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/main.ts --dev",
    "start": "node server/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "hub": "node --disable-warning=ExperimentalWarning scripts/hub.ts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
