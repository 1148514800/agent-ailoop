{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "jsx": "react-jsx", "noEmit": true, "strict": true, "skipLibCheck": true, "isolatedModules": true
  },
  "include": ["src", "server", "shared", "tests"]
}
